# Browser-safe Supabase configuration
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Server-only Supabase credential used by Stripe webhook/verification routes
SUPABASE_SERVICE_ROLE_KEY=

# Stripe credentials. Keep test keys during closed beta.
# A live sk_live_ key is rejected by Checkout/verify unless PING_LIVE_PAYMENTS_ENABLED=true.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
PING_LIVE_PAYMENTS_ENABLED=false
