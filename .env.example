# Browser-safe Supabase configuration
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Native Capacitor bundles cannot host Next.js /api routes locally.
# Point this at the deployed server-only backend (not the marketing site unless it actually serves the API routes).
NEXT_PUBLIC_PINDRIZZLE_API_ORIGIN=

# Server-only Supabase credential used by Stripe/push backend routes
SUPABASE_SERVICE_ROLE_KEY=

# Stripe credentials. Keep test keys during closed beta.
# A live sk_live_ key is rejected by Checkout/verify unless PING_LIVE_PAYMENTS_ENABLED=true.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
PING_LIVE_PAYMENTS_ENABLED=false

# Android native push (Firebase Cloud Messaging HTTP v1 service account)
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# iOS native push (Apple Push Notification service .p8 key)
APNS_KEY_ID=
APNS_TEAM_ID=
APNS_PRIVATE_KEY=
APNS_BUNDLE_ID=com.pindrizzle.app
APNS_USE_SANDBOX=false

# Public operator / legal identity. Fill with reviewed production values before launch.
PING_OPERATOR_NAME=
PING_OPERATOR_ADDRESS=
PING_SUPPORT_EMAIL=
PING_PRIVACY_EMAIL=
PING_SAFETY_EMAIL=
PING_GOVERNING_LAW=
PING_PUBLIC_URL=

# Manual production acknowledgements. Leave false until each external control has been configured and tested.
PING_DOMAIN_READY=false
PING_SMTP_READY=false
PING_AUTH_PRODUCTION_READY=false
PING_STRIPE_ACCOUNT_READY=false
PING_LEGAL_REVIEW_COMPLETE=false
PING_ONLINE_SAFETY_REVIEW_COMPLETE=false
