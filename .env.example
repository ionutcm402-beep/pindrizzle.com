# Browser-safe Supabase configuration
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Native beta wrapper. Set locally when running Capacitor commands.
# Use a stable HTTPS beta origin that does not require a Vercel account to open.
CAPACITOR_SERVER_URL=https://beta.pindrizzle.com

# Server-only Supabase credential used by Stripe webhook/verification routes
SUPABASE_SERVICE_ROLE_KEY=

# Stripe credentials. Pindrizzle must use its own dedicated Stripe account.
# Keep PING_STRIPE_ACCOUNT_READY=false until that separate account is configured and reviewed.
# While false, all Stripe API use is blocked, including test Checkout.
# Live sk_live_ keys also remain rejected unless PING_LIVE_PAYMENTS_ENABLED=true.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
PING_STRIPE_ACCOUNT_READY=false
PING_LIVE_PAYMENTS_ENABLED=false

# Public operator / legal identity. Fill with reviewed production values before launch.
PING_OPERATOR_NAME=
PING_OPERATOR_ADDRESS=
PING_SUPPORT_EMAIL=
PING_PRIVACY_EMAIL=
PING_SAFETY_EMAIL=
PING_GOVERNING_LAW=
PING_PUBLIC_URL=

# Manual production acknowledgements. Leave false until each external control has been configured and tested.
PING_DOMAIN_READY=false
PING_SMTP_READY=false
PING_AUTH_PRODUCTION_READY=false
PING_LEGAL_REVIEW_COMPLETE=false
PING_ONLINE_SAFETY_REVIEW_COMPLETE=false
