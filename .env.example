# Browser-safe Supabase configuration
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Server-only Supabase credential used by Stripe webhook/verification/push routes
SUPABASE_SERVICE_ROLE_KEY=

# Native beta wrapper. Use a stable HTTPS beta deployment that does not require
# temporary Vercel authentication. Do not point distributed beta builds at
# pindrizzle.com unless explicitly approved.
CAPACITOR_SERVER_URL=
ALLOW_NATIVE_PRODUCTION_URL=false
ALLOW_NATIVE_LOCAL_URL=false

# Native iOS push (APNs token authentication).
# TestFlight uses the production APNs environment.
PINDRIZZLE_APNS_TEAM_ID=
PINDRIZZLE_APNS_KEY_ID=
PINDRIZZLE_APNS_PRIVATE_KEY=
PINDRIZZLE_APNS_BUNDLE_ID=com.pindrizzle.app
PINDRIZZLE_APNS_ENV=production

# Native Android push (Firebase Cloud Messaging HTTP v1).
# Store the complete Firebase service-account JSON as one server-only secret.
PINDRIZZLE_FIREBASE_SERVICE_ACCOUNT_JSON=

# Stripe credentials. Keep test keys during closed beta.
# A live sk_live_ key is rejected by Checkout/verify unless PING_LIVE_PAYMENTS_ENABLED=true.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
PING_LIVE_PAYMENTS_ENABLED=false

# Public operator / legal identity. Fill with reviewed production values before launch.
PING_OPERATOR_NAME=
PING_OPERATOR_ADDRESS=
PING_SUPPORT_EMAIL=
PING_PRIVACY_EMAIL=
PING_SAFETY_EMAIL=
PING_GOVERNING_LAW=
PING_PUBLIC_URL=

# Manual production acknowledgements. Leave false until each external control has been configured and tested.
PING_DOMAIN_READY=false
PING_SMTP_READY=false
PING_AUTH_PRODUCTION_READY=false
PING_STRIPE_ACCOUNT_READY=false
PING_LEGAL_REVIEW_COMPLETE=false
PING_ONLINE_SAFETY_REVIEW_COMPLETE=false
