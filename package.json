{
  "name": "ping-app",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "build:native:web": "node scripts/build-capacitor.mjs",
    "cap:sync": "npx cap sync",
    "cap:copy": "npx cap copy",
    "cap:open:ios": "npx cap open ios",
    "cap:open:android": "npx cap open android",
    "native:assets:ios": "npx @capacitor/assets generate --ios --iconBackgroundColor '#eef5f7' --iconBackgroundColorDark '#082b49' --splashBackgroundColor '#eef5f7' --splashBackgroundColorDark '#082b49' --logoSplashScale 0.18",
    "native:assets:android": "npx @capacitor/assets generate --android --iconBackgroundColor '#eef5f7' --iconBackgroundColorDark '#082b49' --splashBackgroundColor '#eef5f7' --splashBackgroundColorDark '#082b49' --logoSplashScale 0.18",
    "native:assets": "npm run native:assets:ios && npm run native:assets:android",
    "native:prepare": "npm run build:native:web && npm run cap:sync"
  },
  "dependencies": {
    "@capacitor/android": "^8.0.0",
    "@capacitor/app": "^8.0.0",
    "@capacitor/camera": "^8.0.0",
    "@capacitor/core": "^8.0.0",
    "@capacitor/geolocation": "^8.0.0",
    "@capacitor/ios": "^8.0.0",
    "@capacitor/push-notifications": "^8.0.0",
    "@capacitor/splash-screen": "^8.0.0",
    "@capacitor/status-bar": "^8.0.0",
    "@supabase/ssr": "^0.7.0",
    "@supabase/supabase-js": "^2.57.4",
    "maplibre-gl": "^5.7.1",
    "next": "15.5.21",
    "react": "19.1.1",
    "react-dom": "19.1.1",
    "stripe": "^22.5.0",
    "web-push": "^3.6.7"
  },
  "devDependencies": {
    "@capacitor/assets": "^3.0.5",
    "@capacitor/cli": "^8.0.0",
    "@types/node": "^22",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/web-push": "^3.6.4",
    "typescript": "^5"
  }
}
